{
    "model": {
        "backend": "sentence_transformers",
        "name": "intfloat/multilingual-e5-large",
        "trust_remote_code": false,
        "default_task": "retrieval.passage",
        "use_prompts": false,
        "openai": {
            "base_url": "https://api.openai.com/v1",
            "dimensions": null,
            "batch_size": 128,
            "timeout": 120,
            "max_retries": 5
        }
    },
    "performance": {
        "precision": "fp16",
        "torch_compile": true,
        "use_fast_tokenizer": true,
        "enable_tf32": true,
        "cudnn_benchmark": true,
        "pin_memory": true,
        "dynamic_batch_sizing": true,
        "warmup_iterations": 3
    },
    "models_info": {
        "all-MiniLM-L6-v2": {
            "dimensions": 384,
            "supports_task": false,
            "description": "Быстрая, но только английский"
        },
        "jinaai/jina-embeddings-v3": {
            "dimensions": 1024,
            "supports_task": true,
            "description": "Универсальная, с task support (trust_remote_code: true)"
        },
        "intfloat/multilingual-e5-large": {
            "dimensions": 1024,
            "supports_task": false,
            "prefixes": {"retrieval.query": "query: ", "retrieval.passage": "passage: "},
            "description": "Отлично для русского и кода, 100+ языков (модель по умолчанию)"
        },
        "intfloat/multilingual-e5-base": {
            "dimensions": 768,
            "supports_task": false,
            "prefixes": {"retrieval.query": "query: ", "retrieval.passage": "passage: "},
